@model HardwareHelper.Models.Zlecenie

@{
    ViewData["Title"] = "Dodaj nowe zgłoszenie";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0">Formularz zgłoszenia serwisowego</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" id="zgloszenieForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <h5 class="text-primary border-bottom pb-2 mb-3">Informacje o sprzęcie</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TypUrzadzenia" class="form-label fw-bold"></label>
                                <select asp-for="TypUrzadzenia" class="form-select" asp-items="Html.GetEnumSelectList<HardwareHelper.Models.TypUrzadzenia>()">
                                    <option value="">-- Wybierz typ --</option>
                                </select>
                                <span asp-validation-for="TypUrzadzenia" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Producent" class="form-label fw-bold"></label>
                                <input asp-for="Producent" class="form-control" placeholder="np. Dell, Asus, Sony" />
                                <span asp-validation-for="Producent" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label fw-bold"></label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NumerSeryjny" class="form-label fw-bold"></label>
                                <input asp-for="NumerSeryjny" class="form-control" placeholder="Opcjonalnie" />
                                <span asp-validation-for="NumerSeryjny" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="OpisUsterki" class="form-label fw-bold"></label>
                            <textarea asp-for="OpisUsterki" class="form-control" rows="4" placeholder="Opisz dokładnie, co się dzieje ze sprzętem..."></textarea>
                            <span asp-validation-for="OpisUsterki" class="text-danger"></span>
                        </div>

                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">Opcje dodatkowe</h5>
                        <div class="form-check form-switch mb-2">
                            <input asp-for="CzyJestZasilacz" class="form-check-input" type="checkbox" />
                            <label asp-for="CzyJestZasilacz" class="form-check-label text-muted">Dołączam zasilacz do przesyłki</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="NaprawaGwarancyjna" class="form-check-input" type="checkbox" id="gwarancjaCheckbox" />
                            <label asp-for="NaprawaGwarancyjna" class="form-check-label fw-bold text-success">Naprawa w ramach gwarancji</label>
                        </div>

                        <div class="mb-4 d-none p-3 bg-light rounded border" id="dataZakupuContainer">
                            <label asp-for="DataZakupu" class="form-label fw-bold"></label>
                            <input asp-for="DataZakupu" type="date" class="form-control" id="dataZakupuInput" />
                            <span asp-validation-for="DataZakupu" class="text-danger fw-bold" id="dataZakupuError"></span>
                            <small class="form-text text-muted">Data na paragonie lub fakturze.</small>
                        </div>

                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">Adres do zamówienia kuriera</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Miasto" class="form-label fw-bold"></label>
                                <input asp-for="Miasto" class="form-control" />
                                <span asp-validation-for="Miasto" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="KodPocztowy" class="form-label fw-bold"></label>
                                <input asp-for="KodPocztowy" class="form-control" placeholder="np. 00-000" />
                                <span asp-validation-for="KodPocztowy" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <label asp-for="Ulica" class="form-label fw-bold"></label>
                                <input asp-for="Ulica" class="form-control" />
                                <span asp-validation-for="Ulica" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Numer" class="form-label fw-bold"></label>
                                <input asp-for="Numer" class="form-control" type="number" />
                                <span asp-validation-for="Numer" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-dark btn-lg" id="submitBtn">
                                <i class="fas fa-paper-plane me-2"></i> Wyślij zgłoszenie
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const gwarancjaCheckbox = document.getElementById("gwarancjaCheckbox");
            const dataZakupuContainer = document.getElementById("dataZakupuContainer");
            const dataZakupuInput = document.getElementById("dataZakupuInput");
            const dataZakupuError = document.getElementById("dataZakupuError");
            const form = document.getElementById("zgloszenieForm");

            // --- LOGIKA 1: POKAZYWANIE I UKRYWANIE POLA ---
            function toggleDataZakupu() {
                if (gwarancjaCheckbox.checked) {
                    dataZakupuContainer.classList.remove("d-none");
                    const today = new Date().toISOString().split('T')[0];
                    dataZakupuInput.setAttribute('max', today);
                } else {
                    dataZakupuContainer.classList.add("d-none");
                    dataZakupuInput.value = "";
                    dataZakupuError.textContent = "";
                }
            }

            gwarancjaCheckbox.addEventListener("change", toggleDataZakupu);

            toggleDataZakupu();

            // --- LOGIKA 2: WALIDACJA DATY PRZY WYSYŁANIU FORMULARZA ---
            form.addEventListener("submit", function (e) {
                if (gwarancjaCheckbox.checked) {
                    if (!dataZakupuInput.value) {
                        e.preventDefault();
                        dataZakupuError.textContent = "Data zakupu jest wymagana przy naprawie gwarancyjnej!";
                        return;
                    }

                    const selectedDate = new Date(dataZakupuInput.value);
                    const now = new Date();
                    now.setHours(0,0,0,0);

                    if (selectedDate > now) {
                        e.preventDefault();
                        dataZakupuError.textContent = "Data zakupu nie może być z przyszłości!";
                    } else {
                        dataZakupuError.textContent = "";
                    }
                }
            });
        });
    </script>
}