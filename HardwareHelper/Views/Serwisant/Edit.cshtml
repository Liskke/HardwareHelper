@model HardwareHelper.Models.Zlecenie

@{
    ViewData["Title"] = "Edycja Zlecenia";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4><i class="bi bi-pencil-square"></i> Zarządzanie Zleceniem #@Model.Id</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="TypUrzadzenia" />

                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="Producent" class="form-label">Producent</label>
                        <input asp-for="Producent" class="form-control" />
                    </div>
                    <div class="col">
                        <label asp-for="Model" class="form-label">Model</label>
                        <input asp-for="Model" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NumerSeryjny" class="form-label">Numer Seryjny (Edycja literówek)</label>
                    <input asp-for="NumerSeryjny" class="form-control" />
                </div>

                <hr />

                <div class="mb-3">
                    <label asp-for="Status" class="form-label font-weight-bold">Status Zlecenia (Lista rozwijana)</label>
                    <select asp-for="Status" class="form-select border-primary">
                        <option value="0">Oczekuje na diagnozę</option>
                        <option value="1">W trakcie naprawy</option>
                        <option value="2">Gotowe do odbioru</option>
                        <option value="3">Anulowane</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ServiceNotes" class="form-label font-weight-bold">Notatki Techniczne Serwisu</label>
                    <textarea asp-for="ServiceNotes" class="form-control" rows="5" placeholder="Wpisz szczegóły diagnozy, wykonane czynności..."></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                    <button type="submit" class="btn btn-success">Zapisz zmiany</button>
                </div>
            </form>
        </div>
    </div>
</div>
