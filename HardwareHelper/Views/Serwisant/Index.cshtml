@model IEnumerable<HardwareHelper.Models.Zlecenie>

@{
    ViewData["Title"] = "Panel Serwisanta";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-speedometer2"></i> Wszystkie Zgłoszenia Serwisowe</h2>

    <form asp-action="Index" method="get" class="row g-3 mb-4 p-3 bg-light rounded border">
        <div class="col-md-6">
            <label class="form-label font-weight-bold">Szukaj (ID, Producent, Model)</label>
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Wpisz frazę..." />
        </div>
        <div class="col-md-4">
            <label class="form-label font-weight-bold">Status zgłoszenia</label>
            <select name="statusFilter" asp-items="Html.GetEnumSelectList<HardwareHelper.Models.ZlecenieStatus>()" class="form-select">
                <option value="">-- Wszystkie --</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filtruj</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nr Naprawy (ID)</th>
                    <th>Sprzęt</th>
                    <th>Model / Producent</th>
                    <th>Data zgłoszenia</th>
                    <th>Status</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td>@item.TypUrzadzenia</td>
                        <td>@item.Producent @item.Model</td>
                        <td>@item.DataUtworzenia.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge bg-secondary">@item.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary"><i class="bi bi-eye"></i> Podgląd</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Edycja / Status</a>
                            <a asp-action="SzczegolyIKomunikacja" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white"><i class="bi bi-chat-dots"></i> Wiadomości</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>