@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white text-center py-4">
                <h3 class="font-weight-light my-2">Serwis Komputerowy</h3>
                <p class="mb-0">Zaloguj się do panelu</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Adres Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="hasło" />
                        <label asp-for="Input.Password" class="form-label">Hasło</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-check mb-3">
                        <label asp-for="Input.RememberMe" class="form-check-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            Zapamiętaj mnie
                        </label>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4 mb-0">
                        <button id="login-submit" type="submit" class="btn btn-primary btn-lg">Zaloguj się</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <div class="small">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">Zapomniałeś hasła?</a>
                    <span class="mx-2 text-muted">|</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Nie masz konta? Zarejestruj się!</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}