@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Odzyskiwanie hasła";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white text-center py-4">
                <h3 class="font-weight-light my-2">Zapomniałeś hasła?</h3>
                <p class="mb-0">Podaj swój adres e-mail, a wyślemy Ci link do resetu.</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Adres Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="d-grid gap-2 mb-0">
                        <button type="submit" class="btn btn-primary btn-lg">Wyślij link resetujący</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <div class="small">
                    <a asp-page="./Login" class="text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i> Powrót do logowania
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}